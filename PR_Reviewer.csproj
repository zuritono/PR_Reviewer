<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PrReviewer</RootNamespace>
    <AssemblyName>PrReviewer</AssemblyName>
  </PropertyGroup>

  <!--
    This project sits in the repo root, and SDK projects pick up every file
    below their folder. The test project in tests/ is built on its own, so
    keep its code (and its bin/obj) out of the app.
  -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <Content Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>

  <!--
    Package references are added via `dotnet add package` (see README/commands
    from Claude) rather than pinned here by hand, so NuGet resolves whatever
    the current compatible version actually is instead of a guessed number.
  -->

  <!--
    The app reads config.json and review_guidelines.md from its own folder,
    so every build copies the current versions there. Edit the files in the
    project folder; a build (or dotnet run) picks up the change.
    config.json is git-ignored and may not exist; Update does nothing then.
  -->
  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="review_guidelines.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
