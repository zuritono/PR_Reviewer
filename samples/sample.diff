diff --git a/db/procs/usp_ArchiveOrders.sql b/db/procs/usp_ArchiveOrders.sql
new file mode 100644
index 0000000..c4e8a21
--- /dev/null
+++ b/db/procs/usp_ArchiveOrders.sql
@@ -0,0 +1,17 @@
+CREATE PROCEDURE dbo.usp_ArchiveOrders
+    @CutoffDate DATETIME
+AS
+BEGIN
+    SELECT * INTO #ToArchive
+    FROM dbo.Orders
+    WHERE OrderDate < @CutoffDate;
+
+    BEGIN TRAN;
+
+    INSERT INTO dbo.OrdersArchive
+    SELECT * FROM #ToArchive;
+
+    DELETE FROM dbo.Orders WHERE OrderDate < @CutoffDate;
+
+    COMMIT;
+END
